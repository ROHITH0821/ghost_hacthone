# Database — Supabase Postgres.
# DATABASE_URL: pooled connection (pgBouncer, port 6543) used by the app at runtime.
# DIRECT_URL:   direct connection (port 5432) used for migrations / prisma db push.
DATABASE_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Auth — generate with: openssl rand -base64 32






AUTH_SECRET="your-secret-key-min-32-chars-long"

# Cron — required for /api/cron/rescan-reminders (Bearer token). Generate with: openssl rand -base64 32
CRON_SECRET="your-cron-secret"

# Dev-only entitlement unlock. Leave unset in production (routes return 404).
# DEV_ENTITLEMENT_KEY=

# Resend — https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="Ghost <onboarding@resend.dev>"

# App URL (used in email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# GHOST engine — Claude API key (required to run real audits)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# Supabase Storage (PDF archive)
# Create a Storage bucket named `ghost-reports` (public).
SUPABASE_URL="https://<ref>.supabase.co"
# Server-only (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_PDF_BUCKET="ghost-reports"

# Optional competitor intelligence (Full Intelligence deep audits)
# TAVILY_API_KEY="tvly-..."                 # web search for competitor discovery
# GHOST_COMPETITOR_MAX=4                    # max competitors crawled
# GHOST_COMPETITOR_PAGES=100                # safety ceiling pages per competitor (default 100)
# GHOST_COMPETITOR_COVERAGE_STOP=0.70       # taxonomy proxy coverage (0–1) recorded on packs
# GHOST_COMPETITOR_MIN_RICH_PAGES=3         # min rich pages before pack coverage is marked sufficient
# GHOST_COMPETITOR_EXTRACT_PAGES=8          # pages sent to feature-extract LLM
# GHOST_COMPETITOR_SEARCH=0                 # disable web search (hints + LLM only)
# Note: thin crawl packs cannot be fixed by regenerate alone — run a new Deep audit.
# Taxonomy v2 / coverage upgrades: POST /api/missions/[id]/regenerate-market-intelligence
# (re-extracts from cache only; re-crawl requires a new audit)
# GHOST_MODEL="claude-sonnet-5"          # personas + aggregation model (default)
# GHOST_FLOW_MODEL="claude-haiku-4-5"    # cheaper model for flow analysis
# GHOST_MAX_FIXES=3                       # top leaks to generate fixes for
# GHOST_STRUCTURED_PARSE_TIMEOUT_MS=180000 # per LLM attempt, clamped to 1–300 seconds; at most 2 retries
# GHOST_ANTHROPIC_TIMEOUT_MS=180000         # underlying SDK transport timeout
# GHOST_CRAWL_MAX_PAGES=250               # safety ceiling of pages fetched per site (default 250)
# GHOST_CRAWL_SITEMAP_INDEXES=50          # max sitemap index/child files to walk
# GHOST_CRAWL_DISCOVER_URLS=2000          # max unique URLs collected from sitemaps + links
# GHOST_CRAWL_CACHE=0                     # disable local disk crawl cache (.cache/crawl); auto-off on Vercel
# GHOST_PDF=0                             # set 0 to skip PDF generation
#
# Post-audit finalize (PDF + email) — separate /api/missions/[id]/finalize invocation
# Audit execution — separate /api/missions/[id]/run invocation (triggered from POST /api/analyze)
# NEXT_PUBLIC_APP_URL + CRON_SECRET required for both run and finalize triggers; cron sweepers retry if fetch fails
# AUDIT_MAX_CONCURRENT=3                  # max running audits per user (default 3)
# AUDIT_MAX_PER_HOUR=10                   # max audit submissions per user per hour (default 10)
# AUDIT_DEDUP_WINDOW_MS=60000             # dedup window for same user+domain submits (default 60s)
# GHOST_COMPETITOR_INTEL_BUDGET_MS=240000 # competitor pipeline attempt during finalize (default 240s, max 400s)
# GHOST_PDF_BUDGET_MS=60000               # max ms for Playwright PDF generation during finalize
# RUN_CRON_LIMIT=3                        # missions processed per /api/cron/run-missions run
# FINALIZE_CRON_LIMIT=5                   # missions processed per /api/cron/finalize-missions run
# BACKFILL_INTEL=1                        # with pdf:backfill, retry failed competitor research before finalize
#
# Industry benchmarks (off until real aggregate data exists)
# INDUSTRY_BENCHMARKS_ENABLED=false
#
# Optional: Google Analytics 4 (GA4) Integration
# When unset, Ghost functions normally in website-only analysis mode.
# GOOGLE_ANALYTICS_CLIENT_ID="xxx.apps.googleusercontent.com"
# GOOGLE_ANALYTICS_CLIENT_SECRET="GOCSPX-xxx"
# GOOGLE_ANALYTICS_APP_ORIGIN="https://ghost.webauraindia.com" # or "http://localhost:3000" for dev
# GOOGLE_ANALYTICS_ENCRYPTION_KEY=""  # Generate with: openssl rand -base64 32
#
# NOTE: crawling/PDF need the Playwright browser once:
#   npx playwright install chromium
