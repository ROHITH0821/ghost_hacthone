{
  "regions": ["bom1"],
  "env": {
    "AWS_LAMBDA_JS_RUNTIME": "nodejs22.x"
  },
  "crons": [
    {
      "path": "/api/cron/run-missions",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/finalize-missions",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/sync-analytics",
      "schedule": "0 1 * * *"
    }
  ]
}
